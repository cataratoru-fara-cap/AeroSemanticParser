# Copy to .env and fill in. `.env` is gitignored; this template is not.
#   cp .env.example .env

# --- Airflow ---
_AIRFLOW_VERSION=3.2.2
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Must match the host user that owns ./dags, ./logs, ./data, or the
# containers write root-owned files into your working tree:  id -u
AIRFLOW_UID=1001
AIRFLOW_GID=0
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_API_AUTH_JWT_SECRET=change-me

# Reinstalled in every container on every start — keep empty.
# Real dependencies belong in requirements.txt.
_PIP_ADDITIONAL_REQUIREMENTS=

# --- Postgres (Airflow metadata DB) ---
# The password is embedded in Airflow's connection URLs, so keep it URL-safe
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`). It only
# initialises a NEW volume: to rotate it on an existing one, also run
#   docker compose exec postgres psql -c "ALTER ROLE airflow WITH PASSWORD '...'"
# then `docker compose up -d`.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# --- MongoDB (the pipeline's own data: urls, doms, entries, run_summaries) ---
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=memes
MONGO_PORT=27017

# --- pgAdmin (web UI at http://<host>:8080/pgadmin/) ---
# Must be a real address with a real-looking domain: pgAdmin rejects
# e.g. admin@localhost at startup.
PGADMIN_DEFAULT_EMAIL=you@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# --- ScrapingAnt (the scrape stage; browser=false ≈ 1 credit per URL) ---
SCRAPINGANT_API_KEY=

# --- KG stage (kym_kg builds the graph; kym_kg_validate re-derives and diffs it) ---
# Collection names have defaults in docker-compose.yml; override only to
# point a deployment at differently-named collections.
MONGODB_KG_NODES_COLLECTION=kg_nodes
MONGODB_KG_EDGES_COLLECTION=kg_edges
MONGODB_KG_BUILDS_COLLECTION=kg_builds

# --- KG graph stores (kym_kg publishes every build into both) ---
# Neo4j holds the property graph. Bolt 7687 and the Browser on 7474 are
# bound to 127.0.0.1 — the campus firewall drops them anyway — so use an SSH
# tunnel of BOTH ports (the Browser opens its own Bolt connection):
#   ssh -L 7474:localhost:7474 -L 7687:localhost:7687 <host>
# python -c "import secrets; print(secrets.token_urlsafe(24))"
NEO4J_PASSWORD=change-me
# Fuseki holds the RDF graph. SPARQL is public but READ-ONLY through the
# proxy at http://<host>:8080/sparql/kg/query; writes go over the Docker
# network only, authenticated with this password.
FUSEKI_ADMIN_PASSWORD=change-me

# --- Model servers (modules/openwebui_client.py; kg/semantics.py) ---
# Open WebUI in front of Ollama on the lab's pagoda hosts. The client fails
# over between hosts and, within a tier and specialization, between models —
# but never changes model mid-run. Rules: the module's docstring.
#
# Hosts in priority order; empty = ollama-ccdd, then ollama-ui.
OPENWEBUI_HOSTS=
# Keys are PER HOST (Open WebUI -> Settings -> Account -> API keys, on each
# host). A host's key is OPENWEBUI_API_KEY_<first DNS label, upper, _>;
# OPENWEBUI_API_KEY is the fallback for any host without its own.
OPENWEBUI_API_KEY_OLLAMA_CCDD=
OPENWEBUI_API_KEY_OLLAMA_UI=
OPENWEBUI_API_KEY=
# Cloud-proxied models (e.g. minimax-m2.7:cloud) send prompts off-site.
OPENWEBUI_ALLOW_CLOUD=false
# Correct the curated "what is this model optimised for" table:
#   OPENWEBUI_SPECIALIZATION_OVERRIDES=mixtral:8x7b=general,glm-ocr:latest=vision
OPENWEBUI_SPECIALIZATION_OVERRIDES=
# What kg/semantics.py asks for. TIER: sm|md|lg|xl (the fallback band when the
# model is unknown); SPECIALIZATION: general|vision|coding|any.
KG_CHAT_MODEL=mistral-small3.2:24b
KG_CHAT_TIER=
KG_CHAT_SPECIALIZATION=
KG_EMBED_MODEL=qwen3-embedding:0.6b
KG_EMBED_TIER=

# --- Dashboard (Streamlit, read-only analytics UI) ---
DASHBOARD_PORT=8501

# --- mongo-express (web UI at http://<host>:8080/mongo/) ---
# Login for the web UI only; distinct from the Mongo root credentials.
# python -c "import secrets; print(secrets.token_hex(16))"
MONGO_EXPRESS_USER=kym_admin
MONGO_EXPRESS_PASSWORD=change-me
MONGO_EXPRESS_SESSION_SECRET=change-me

# --- Proxy (the only port reachable from the network) ---
PROXY_PORT=8080
