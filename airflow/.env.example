# Copy to .env and fill in. `.env` is gitignored; this template is not.
#   cp .env.example .env

# --- Airflow ---
_AIRFLOW_VERSION=3.2.2
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Must match the host user that owns ./dags, ./logs, ./data, or the
# containers write root-owned files into your working tree:  id -u
AIRFLOW_UID=1001
AIRFLOW_GID=0
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_API_AUTH_JWT_SECRET=change-me

# Reinstalled in every container on every start — keep empty.
# Real dependencies belong in requirements.txt.
_PIP_ADDITIONAL_REQUIREMENTS=

# --- Postgres (Airflow metadata DB) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# --- MongoDB (the pipeline's own data: urls, doms, entries, run_summaries) ---
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=memes
MONGO_PORT=27017

# --- pgAdmin (web UI at http://<host>:8080/pgadmin/) ---
# Must be a real address with a real-looking domain: pgAdmin rejects
# e.g. admin@localhost at startup.
PGADMIN_DEFAULT_EMAIL=you@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# --- ScrapingAnt (the scrape stage; browser=false ≈ 1 credit per URL) ---
SCRAPINGANT_API_KEY=

# --- Pagoda / Ollama (post-parse KG semantics; unused by the 3 live DAGs) ---
PAGODA_OLLAMA_URL=
OPENWEBUI_API_KEY=
KG_CHAT_MODEL=
KG_EMBED_MODEL=

# --- Dashboard (Streamlit, read-only analytics UI) ---
DASHBOARD_PORT=8501

# --- mongo-express (web UI at http://<host>:8080/mongo/) ---
# Login for the web UI only; distinct from the Mongo root credentials.
# python -c "import secrets; print(secrets.token_hex(16))"
MONGO_EXPRESS_USER=kym_admin
MONGO_EXPRESS_PASSWORD=change-me
MONGO_EXPRESS_SESSION_SECRET=change-me

# --- Proxy (the only port reachable from the network) ---
PROXY_PORT=8080
