# memeatlas.ttl — the MemeAtlas vocabulary, an extension of IMKG
# ============================================================================
# MemeAtlas extends IMKG, the Internet Meme Knowledge Graph. It reuses IMKG's
# terms wherever the two describe the same thing — m4s:MediaFrame, m4s:title,
# m4s:status, m4s:year, m4s:from, m4s:about, m4s:added,
# m4s:last_update_source, m4s:tag, kym:<Category> and kymt:<type> classes,
# and skos:broader / skos:narrower between frames of a series — and does NOT
# redeclare them here: they are IMKG's.
#
# This file declares only what MemeAtlas adds, under mk:, and aligns each
# addition to IMKG, SKOS or schema.org where one fits, so a consumer that
# understands those vocabularies can read MemeAtlas without knowing mk:.
#
# What is a resource, and what is an annotation (4.0.0)
# -----------------------------------------------------
# A resource is something other things can share: a media frame, an entry
# type, an image file, a URL. Page content that belongs to ONE frame is a
# literal on it (m4s:about, mk:sectionText), as IMKG does for About/Origin/
# Spread. What belongs to ONE mention of a target — a link's anchor text, a
# citation's text, an image's caption on this page — annotates the quoted
# edge, with RDF-star:
#
#   <frame> mk:citesExternal <url> .
#   << <frame> mk:citesExternal <url> >> mk:citationText "..." .
#
# SPARQL-star:  SELECT ?t { << ?f mk:citesExternal ?u >> mk:citationText ?t }
#
# The annotation properties are therefore declared as rdf:Property with no
# rdfs:domain: their subject is a quoted triple, not an individual.
#
# Published into Fuseki as the named graph <urn:memeatlas:ontology> and
# copied into every build directory. tests/test_kg_vocabulary.py asserts
# every mk: term the serializer can emit is declared below, and that nothing
# is declared that is never emitted — one declaration per line starting with
# the term, which is the layout that test relies on.
#
# The namespace https://meme4.science/atlas/ sits under the domain IMKG's
# m4s: vocabulary uses. That is to be agreed with IMKG's authors before
# publication.

@prefix mk:     <https://meme4.science/atlas/> .
@prefix m4s:    <https://meme4.science/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
# SEM, the Simple Event Model — the vocabulary EventKG is built on. Used
# for ALIGNMENT ONLY: no sem: term is ever emitted into the graph, exactly
# as with schema:, dct: and prov: above. Aligning costs this one line;
# emitting a foreign vocabulary would cost an entry in kg/rdf.py's
# PREFIXES, one in the YARRRML prefixes block, and ~120k triples asserting
# classes MemeAtlas does not own. tests/test_kg_vocabulary.py pins that
# asymmetry so nobody "helpfully" promotes it later.
@prefix sem:    <http://semanticweb.cs.vu.nl/2009/11/sem/> .

<https://meme4.science/atlas/> a owl:Ontology ;
    rdfs:label "MemeAtlas" ;
    dct:description """An extension of IMKG, the Internet Meme Knowledge Graph.
MemeAtlas describes the full parsed record of each Know Your Meme entry —
its section text, links, references, images, regions and corpus grading —
on top of IMKG's model of media frames, which it reuses unchanged.""" ;
    owl:versionInfo "6.1.0" ;
    rdfs:seeAlso <https://doi.org/10.1007/978-3-031-33455-9_21> ,
                 <https://github.com/riccardotommasini/imkg> ;
    prov:wasDerivedFrom <https://doi.org/10.5281/zenodo.7457166> .

# ---------------------------------------------------------------------------
# Classes
# ---------------------------------------------------------------------------

mk:Image a owl:Class ;
    rdfs:subClassOf schema:ImageObject ;
    rdfs:label "Image" ;
    rdfs:comment "An image file shown on one or more entry pages, identified by its own URL. How it is shown on a particular page (role, caption, alt text) annotates that page's mk:hasImage edge." .

mk:EntryTypeScheme a skos:ConceptScheme ;
    rdfs:label "MemeAtlas entry-type taxonomy" ;
    rdfs:comment "The Know Your Meme entry types (IMKG's kymt: classes), also treated as SKOS concepts, with a curated rdfs:subClassOf hierarchy between them." .

mk:OriginScheme a skos:ConceptScheme ;
    rdfs:label "MemeAtlas origin taxonomy" ;
    rdfs:comment "Canonicalized values of the entry's infobox Origin field (m4s:from) -- platforms, countries, franchises, companies, games, people. A curated rdfs:subClassOf hierarchy exists only over the subset that is actually a platform (e.g. mk:origin/twitter subClassOf mk:origin/social-network); see kg/origin.py." .

mk:BadgeScheme a skos:ConceptScheme ;
    rdfs:label "MemeAtlas badge taxonomy" ;
    rdfs:comment "Content-warning badges Know Your Meme shows on an entry (e.g. Sensitive)." .

# ---------------------------------------------------------------------------
# Relations between resources
# ---------------------------------------------------------------------------

mk:relatesToMeme a owl:ObjectProperty ;
    rdfs:subPropertyOf rdfs:seeAlso ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:label "relates to meme" ;
    rdfs:comment "The entry links to another Know Your Meme entry anywhere on its page or in its references. Broader than IMKG's rdfs:seeAlso, which covers only the Related Entries box. Each mention may be annotated (mk:anchorText, mk:inSection, mk:citationText, ...)." .

mk:citesExternal a owl:ObjectProperty ;
    rdfs:subPropertyOf rdfs:seeAlso ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:label "cites external" ;
    rdfs:comment "The entry links to a resource outside Know Your Meme, in its body or its references. Each mention may be annotated." .

mk:hasImage a owl:ObjectProperty ;
    rdfs:subPropertyOf schema:image ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:range mk:Image ;
    rdfs:label "has image" ;
    rdfs:comment "An image shown on the entry's page: its page image or one shown in a section. Each showing may be annotated (mk:imageRole, mk:inSection, mk:altText, mk:caption)." .

mk:hasOrigin a owl:ObjectProperty ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:range mk:OriginScheme ;
    rdfs:label "has origin" ;
    rdfs:comment "The canonicalized concept behind m4s:from. NOT platform-only: many origin values are countries, franchises, companies or people, canonicalized (e.g. 'United States' / 'USA' / 'America' -> one concept) the same way a genuine platform's variant spellings are ('Twitter' / 'X / Twitter' / 'twitter.com')." .

mk:badge a owl:ObjectProperty ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:range mk:BadgeScheme ;
    rdfs:label "badge" ;
    rdfs:comment "A badge Know Your Meme shows on the entry, e.g. Sensitive. owl:ObjectProperty as of 5.0.0 (was owl:DatatypeProperty in 4.0.0, a literal) -- see MODEL.md's Deliberate differences." .

# ---------------------------------------------------------------------------
# Media frame attributes IMKG does not model
# ---------------------------------------------------------------------------

mk:region a owl:DatatypeProperty ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:label "region" ;
    rdfs:comment "A region the entry is associated with, as named by Know Your Meme." .

mk:description a owl:DatatypeProperty ;
    rdfs:subPropertyOf schema:description ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:label "description" ;
    rdfs:comment "The entry's one-sentence summary." .

mk:sectionText a owl:DatatypeProperty ;
    rdfs:subPropertyOf schema:articleBody ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:label "section text" ;
    rdfs:comment "One section of the entry page that has text, as its heading, a blank line, then its paragraphs. The three narrative sections are excluded, each having an IMKG term of its own: m4s:about, m4s:origin, m4s:spread." .

mk:corpusStatus a owl:DatatypeProperty ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:label "corpus status" ;
    rdfs:comment "ready or incomplete, against the MemeAtlas corpus policy." .

mk:corpusMissing a owl:DatatypeProperty ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:label "corpus missing" ;
    rdfs:comment "A field the corpus policy requires that the entry lacks." .

mk:parserVersion a owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:label "parser version" .

mk:parsedAt a owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:range xsd:dateTime ;
    rdfs:label "parsed at" .

mk:scrapedAt a owl:DatatypeProperty ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:range xsd:dateTime ;
    rdfs:label "scraped at" .

# ---------------------------------------------------------------------------
# Image attributes (of the file itself)
# ---------------------------------------------------------------------------

mk:width a owl:DatatypeProperty ;
    rdfs:domain mk:Image ;
    rdfs:range xsd:integer ;
    rdfs:label "width" ;
    rdfs:comment "Pixels." .

mk:height a owl:DatatypeProperty ;
    rdfs:domain mk:Image ;
    rdfs:range xsd:integer ;
    rdfs:label "height" ;
    rdfs:comment "Pixels." .

# ---------------------------------------------------------------------------
# Occurrence annotations (subject: a quoted mk:relatesToMeme, mk:citesExternal
# or mk:hasImage triple — see the header)
# ---------------------------------------------------------------------------

mk:anchorText a rdf:Property ;
    rdfs:label "anchor text" ;
    rdfs:comment "The text of a link on the entry page that points at the target." .

mk:inSection a rdf:Property ;
    rdfs:label "in section" ;
    rdfs:comment "The heading of the page section a link or image appeared under." .

mk:citationText a rdf:Property ;
    rdfs:label "citation text" ;
    rdfs:comment "The text of an item in the entry's numbered External References list." .

mk:citationIndex a rdf:Property ;
    rdfs:range xsd:integer ;
    rdfs:label "citation index" ;
    rdfs:comment "The number Know Your Meme gives that citation." .

mk:siteName a rdf:Property ;
    rdfs:label "site name" ;
    rdfs:comment "The site an item of the entry's Additional References box is named after (Wikipedia, Urban Dictionary, ...)." .

mk:imageRole a rdf:Property ;
    rdfs:label "image role" ;
    rdfs:comment "page: the entry's own image (og:image / template). section: an image shown in one of its sections." .

mk:altText a rdf:Property ;
    rdfs:label "alt text" ;
    rdfs:comment "The alt text the image has on this page." .

mk:caption a rdf:Property ;
    rdfs:subPropertyOf schema:caption ;
    rdfs:label "caption" ;
    rdfs:comment "The caption the image has on this page." .

# ---------------------------------------------------------------------------
# Events (6.0.0) — extracted from the Origin and Spread narrative by an LLM
#
# These are the only resources in MemeAtlas that are DERIVED rather than
# parsed: each one is a model's reading of a sentence, not a value scraped
# from the page. Every event therefore carries mk:extractionModel and
# mk:sourceText, so a consumer can tell model output from scraped fact and
# trace any row back to the exact prose it came from.
#
# The what/when/where/who skeleton and the traceability rule come from
# EventKG; its per-statement named-graph reification and its cross-source
# event registry deliberately do not. See kg_config/MODEL.md.
# ---------------------------------------------------------------------------

mk:Event a owl:Class ;
    rdfs:subClassOf sem:Event , schema:Event ;
    rdfs:label "Event" ;
    rdfs:comment "One spatio-temporal happening extracted from a media frame's Origin or Spread narrative. Derived from the page by a language model, not scraped from it." .

mk:hasEvent a owl:ObjectProperty ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:range mk:Event ;
    rdfs:label "has event" ;
    rdfs:comment "An event narrated by this entry's Origin or Spread section." .

mk:sourceText a owl:DatatypeProperty ;
    rdfs:domain mk:Event ;
    rdfs:label "source text" ;
    rdfs:comment "The sentences of the section this event was read from, copied verbatim from the page by the pipeline, citation markers included. The model only points at sentences by number, so it cannot alter this text; there is deliberately no model-written summary." .

mk:eventLink a owl:ObjectProperty ;
    rdfs:subPropertyOf rdfs:seeAlso ;
    rdfs:domain mk:Event ;
    rdfs:label "event link" ;
    rdfs:comment "A hyperlink that appears inside the event's own sentences. Attached by the link's position on the page, never chosen by the model." .

mk:eventCitation a owl:ObjectProperty ;
    rdfs:subPropertyOf rdfs:seeAlso ;
    rdfs:domain mk:Event ;
    rdfs:label "event citation" ;
    rdfs:comment "The reference that a [n] citation marker in the event's sentences points to — the page's own evidence for the event." .

mk:eventEmbed a owl:ObjectProperty ;
    rdfs:subPropertyOf rdfs:seeAlso ;
    rdfs:domain mk:Event ;
    rdfs:label "event embed" ;
    rdfs:comment "An embedded post (a TikTok, a tweet, an Instagram reel, a video) shown right after a paragraph narrating the event. Position cannot tell apart two events narrated in one paragraph, so both carry its media." .

mk:eventImage a owl:ObjectProperty ;
    rdfs:subPropertyOf schema:image ;
    rdfs:domain mk:Event ;
    rdfs:range mk:Image ;
    rdfs:label "event image" ;
    rdfs:comment "A photo shown right after a paragraph narrating the event, attached by position like mk:eventEmbed." .

mk:sourceSection a owl:DatatypeProperty ;
    rdfs:domain mk:Event ;
    rdfs:label "source section" ;
    rdfs:comment "Which narrative section this event came from: origin or spread." .

mk:eventStart a owl:DatatypeProperty ;
    rdfs:subPropertyOf sem:hasBeginTimeStamp ;
    rdfs:domain mk:Event ;
    rdfs:range xsd:dateTime ;
    rdfs:label "event start" ;
    rdfs:comment "Start of the interval the source's date covers, at the precision the source gave. Absent when the source gave no date." .

mk:eventEnd a owl:DatatypeProperty ;
    rdfs:subPropertyOf sem:hasEndTimeStamp ;
    rdfs:domain mk:Event ;
    rdfs:range xsd:dateTime ;
    rdfs:label "event end" ;
    rdfs:comment "End of that interval, inclusive. A year-precision event spans its whole year rather than being flattened to January 1st." .

mk:datePrecision a owl:DatatypeProperty ;
    rdfs:domain mk:Event ;
    rdfs:label "date precision" ;
    rdfs:comment "How much of the date the source actually gave: day, month, year, or none. Read this before treating eventStart as exact." .

mk:dateBasis a owl:DatatypeProperty ;
    rdfs:domain mk:Event ;
    rdfs:label "date basis" ;
    rdfs:comment "Where the date came from: \"stated\" = parsed from the event's own date words; \"relative\" = counted from mk:dateAnchoredTo by the offset those words give (\"that same day\", \"the following day\"). Absent when the event is undated. The model never dates anything: it returns the words, the pipeline does the arithmetic." .

mk:dateAnchoredTo a owl:ObjectProperty ;
    rdfs:domain mk:Event ;
    rdfs:range mk:Event ;
    rdfs:label "date anchored to" ;
    rdfs:comment "The earlier event a relative date was counted from, so a derived date is always traceable to a stated one." .

mk:dateText a owl:DatatypeProperty ;
    rdfs:domain mk:Event ;
    rdfs:label "date text" ;
    rdfs:comment "The phrase the date was read from ('early 2013', 'that same day'), kept because normalising loses the nuance it carried." .

mk:eventLocation a owl:DatatypeProperty ;
    rdfs:domain mk:Event ;
    rdfs:label "event location" ;
    rdfs:comment "Where it happened — a place, a platform, or both — as free text. Not aligned to sem:hasPlace: that is an object property, so a datatype property cannot be its subproperty. Resolving platforms to mk:origin/ concepts is deliberately left to a later version." .

mk:locationType a owl:DatatypeProperty ;
    rdfs:domain mk:Event ;
    rdfs:label "location type" ;
    rdfs:comment "What kind of value eventLocation holds: geo, platform, both, or unknown." .

mk:certainty a owl:DatatypeProperty ;
    rdfs:domain mk:Event ;
    rdfs:label "certainty" ;
    rdfs:comment "How certain the source itself was: confirmed, disputed, unconfirmed or debunked. A rumour stays a rumour in the graph rather than being flattened into fact." .

mk:eventActor a owl:DatatypeProperty ;
    rdfs:subPropertyOf sem:hasActor ;
    rdfs:domain mk:Event ;
    rdfs:label "event actor" ;
    rdfs:comment "A person, account, community or organization the source names as taking part, verbatim as written. A literal in this version: these are usernames and handles, with no identity resolution behind them yet." .

mk:extractionModel a owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:domain mk:Event ;
    rdfs:label "extraction model" ;
    rdfs:comment "The language model that produced this event. Present on every event, because this is the one part of the graph that is inferred rather than observed." .

mk:extractionVersion a owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:domain mk:Event ;
    rdfs:label "extraction version" ;
    rdfs:comment "Version of the extraction contract (prompt, schema and validation rules) this event was produced under." .

# ---------------------------------------------------------------------------
# Wikidata entities (6.1.0) — recognised in the title, tags and About section
# by NLP and linked to Wikidata from a local copy of its dump.
#
# Like events, DERIVED rather than parsed: a linker's reading of the page.
# IMKG's own predicates carry the About and tag links, verbatim — they are
# IMKG's, so they are not redeclared here:
#
#   <frame> m4s:fromAbout <http://www.wikidata.org/entity/Q…> .
#   <frame> m4s:fromTags  <http://www.wikidata.org/entity/Q…> .
#
# IMKG never linked titles; mk:fromTitle is the same idea for the title. The
# object is Wikidata's canonical entity IRI (IMKG used the /wiki/ page URL;
# see MODEL.md, Deliberate differences), labelled with rdfs:label and given
# no class. Each MENTION annotates the quoted edge, like a link's anchor
# text does:
#
#   << <frame> m4s:fromAbout wd:Q39315 >> mk:mentionText "Shiba Inus" ;
#                                         mk:linkScore 0.83 ;
#                                         mk:linkMethod "ner" .
# ---------------------------------------------------------------------------

mk:fromTitle a owl:ObjectProperty ;
    rdfs:domain m4s:MediaFrame ;
    rdfs:label "from title" ;
    rdfs:comment "A Wikidata item named by the entry's title — the title's counterpart of IMKG's m4s:fromAbout and m4s:fromTags, which IMKG did not have. When Wikidata records this very page as the item's Know Your Meme slug (P13484), the link is certain (mk:linkMethod \"kym_id\", mk:linkScore 1.0): the item IS the meme." .

mk:mentionText a rdf:Property ;
    rdfs:label "mention text" ;
    rdfs:comment "The words on the page a linked Wikidata item was recognised in, verbatim (annotates a quoted m4s:fromAbout, m4s:fromTags or mk:fromTitle triple)." .

mk:linkScore a rdf:Property ;
    rdfs:range xsd:decimal ;
    rdfs:label "link score" ;
    rdfs:comment "How strongly the linker preferred this item for that mention, 0 to 1: Wikipedia popularity, overlap between the item's description and the entry's text, a label (not alias) match, agreement with the NER type, and whether the item is itself on Know Your Meme. Not a probability. Links under the linker's threshold are not emitted; which of the rest matter to the meme is a later curation step." .

mk:linkMethod a rdf:Property ;
    rdfs:label "link method" ;
    rdfs:comment "How the mention was found: kym_id (the item's Know Your Meme slug is this page), title (the whole title), tag (a whole tag), ner (a named entity), propn (a run of proper nouns), noun_chunk (a noun phrase or its head — often a common-noun concept)." .

mk:nerLabel a rdf:Property ;
    rdfs:label "NER label" ;
    rdfs:comment "The named-entity type the NLP model gave the mention (PERSON, ORG, GPE, ...), when it gave one. A hint the linker used, never a filter: the model is often wrong about internet names." .

# ---------------------------------------------------------------------------
# Build provenance (describes the published graph, not the corpus)
# ---------------------------------------------------------------------------

mk:buildId a owl:DatatypeProperty ;
    rdfs:label "build id" .

mk:snapshotAt a owl:DatatypeProperty ;
    rdfs:label "snapshot at" .

mk:kgBuildVersion a owl:DatatypeProperty ;
    rdfs:label "KG build version" .

mk:taxonomyVersion a owl:DatatypeProperty ;
    rdfs:label "taxonomy version" ;
    rdfs:comment "sha256 of the curated taxonomy file the build used." .
